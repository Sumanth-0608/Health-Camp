# Secret key for session encryption - replace with a random 32+ character string in production
SECRET_KEY=dev-secret-key-change-in-production-wellness90

# Database URL - default is SQLite in project data folder
# For PostgreSQL in production, use: postgresql://user:password@localhost:5432/wellness_db
DATABASE_URL=sqlite:///wellness.db

# Upload directory (absolute or relative to app root)
UPLOAD_FOLDER=uploads

# Maximum upload size in bytes (8MB)
MAX_CONTENT_LENGTH=8388608

# Application port and host
PORT=5000
HOST=127.0.0.1
DEBUG=True
