# Local development values only. Set private production values in your host's environment settings.
APP_ENV=development
SECRET_KEY=replace-with-a-private-random-value

# SQLite is for local development only. Production requires the hosted PostgreSQL URL from your provider.
DATABASE_URL=sqlite:///wellness.db

# Upload directory (absolute or relative to app root)
UPLOAD_FOLDER=uploads

# Maximum upload size in bytes (8MB)
MAX_CONTENT_LENGTH=8388608

# Application port and host
PORT=5000
HOST=127.0.0.1
DEBUG=True
